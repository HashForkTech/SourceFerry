# SourceFerry's one-command installer creates .env privately. Never commit real secrets.
LOCAL_WEB_API_TOKEN=CHANGE_ME
CRAWL4AI_API_TOKEN=CHANGE_ME
SEARXNG_SECRET_KEY=CHANGE_ME

# Loopback by default. Set a LAN interface address (or 0.0.0.0) for remote clients.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080
LOCAL_WEB_GATEWAY_URL=http://127.0.0.1:8080

# Images are frozen by digest. Use verified compatible references for upgrades.
PYTHON_IMAGE=python:3.12-slim@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f
SEARXNG_IMAGE=ghcr.io/searxng/searxng:2026.10.7-6671d89be@sha256:cc026dbee25b864d7f9731957cd5ef36ba2e2d61abd2996d57f1b863483e7409
CRAWL4AI_IMAGE=unclecode/crawl4ai:0.9.4@sha256:9021b3cb5c6f12570bbcd5395638495e0a06969b3148e377b953d174af2ebc9b

# Seconds: positive finite values up to 3600. See docs/CONFIGURATION.md.
SEARXNG_TIMEOUT_SECONDS=120
CRAWL4AI_TIMEOUT_SECONDS=120
REQUEST_DEADLINE_SECONDS=300
# Shared across search and fetch in one gateway process: 1..32 crawls.
ENRICHMENT_CONCURRENCY=4
# Cleaned crawler snippets only: 128..10000 characters; fallback is unchanged.
SNIPPET_MAX_CHARS=1200
# Admitted requests: 1..64. Excess requests receive 503 without queueing.
GATEWAY_MAX_REQUESTS=8
# Bytes: 1024..1048576 request, 65536..33554432 per upstream response.
MAX_REQUEST_BYTES=65536
MAX_UPSTREAM_BYTES=8388608
# Characters read by snippet cleanup: 10000..262144.
SNIPPET_INPUT_MAX_CHARS=65536

# Client timeout: positive finite seconds up to 7200.
API_CLIENT_TIMEOUT_SECONDS=1200
